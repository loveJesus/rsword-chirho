<?xml version="1.0" encoding="UTF-8"?>
<osis xmlns="http://www.bibletechnologies.net/2003/OSIS/namespace">
  <osisText osisIDWork="TestBible" osisRefWork="bible" xml:lang="en">
    <header>
      <work osisWork="TestBible">
        <title>Test Bible</title>
        <type type="OSIS">Bible</type>
        <identifier type="OSIS">Bible.TestBible</identifier>
        <language type="SIL">ENG</language>
      </work>
    </header>
    <div type="book" osisID="Gen">
      <chapter osisID="Gen.1">
        <verse osisID="Gen.1.1">In the beginning God created the heaven and the earth.</verse>
        <verse osisID="Gen.1.2">And the earth was without form, and void; and darkness was upon the face of the deep.</verse>
        <verse osisID="Gen.1.3">And God said, Let there be light: and there was light.</verse>
      </chapter>
    </div>
    <div type="book" osisID="John">
      <chapter osisID="John.3">
        <verse osisID="John.3.16">For God so loved the world, that he gave his only begotten Son.</verse>
        <verse osisID="John.3.17">For God sent not his Son into the world to condemn the world.</verse>
      </chapter>
    </div>
    <div type="book" osisID="Rev">
      <chapter osisID="Rev.22">
        <verse osisID="Rev.22.21">The grace of our Lord Jesus Christ be with you all. Amen.</verse>
      </chapter>
    </div>
  </osisText>
</osis>
